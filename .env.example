# Local development can set this to 0 for plain HTTP; public HTTPS should keep 1.
EBUNGE_COOKIE_SECURE=0
# Optional absolute or application-relative path. Default: var/ebunge.sqlite
EBUNGE_DB_PATH=var/ebunge.sqlite
# Configure both values and PHP mail() before using real password-reset emails.
EBUNGE_MAIL_FROM=
EBUNGE_PUBLIC_URL=http://127.0.0.1:3000
# Optional absolute or application-relative private upload directory. Default: var/uploads
EBUNGE_UPLOAD_DIR=var/uploads
